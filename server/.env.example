# =================================================================
# B★SEL ACADEMY BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to '.env' inside this directory and fill in your actual credentials.
# NOTE: Never commit your real '.env' file with actual secrets to git!

PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE
# -----------------------------------------------------------------
# Format: postgresql://[user]:[password]@[endpoint-id].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@your_endpoint.neon.tech/your_dbname?sslmode=require

# -----------------------------------------------------------------
# 2. AMAZON S3 CLOUD STORAGE
# -----------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-2
AWS_BUCKET_NAME=your_s3_bucket_name
