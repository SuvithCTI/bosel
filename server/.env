# =================================================================
# B★SEL ACADEMY BACKEND ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE
# -----------------------------------------------------------------
# Paste your Neon Connection String below (found in your Neon Dashboard):
# Format: postgresql://[user]:[password]@[endpoint-id].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------
# 2. AMAZON S3 CLOUD STORAGE
# -----------------------------------------------------------------
# Your AWS S3 Credentials and Bucket info:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
